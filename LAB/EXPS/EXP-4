from collections import deque

moves = [(1,0), (2,0), (0,1), (0,2), (1,1)]
q = deque([((3,3,0), [(3,3,0)])])
seen = {(3,3,0)}

while q:
    (m,c,b), path = q.popleft()

    if (m,c,b) == (0,0,1):
        print(*path, sep="\n")
        break

    for x,y in moves:
        nm,nc = (m-x,c-y) if b == 0 else (m+x,c+y)
        nb = 1-b

        if 0 <= nm <= 3 and 0 <= nc <= 3:
            if (nm == 0 or nm >= nc) and (3-nm == 0 or 3-nm >= 3-nc):
                s = (nm,nc,nb)
                if s not in seen:
                    seen.add(s)
                    q.append((s,path+[s]))
