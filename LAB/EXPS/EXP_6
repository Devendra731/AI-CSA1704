from collections import deque

g = {
    "A":["B","C"],
    "B":["D","E"],
    "C":["F"],
    "D":[],
    "E":[],
    "F":[]
}

def bfs(start):
    q = deque([start])
    visited = {start}

    while q:
        v = q.popleft()
        print(v, end=" ")

        for n in g[v]:
            if n not in visited:
                visited.add(n)
                q.append(n)

bfs("A")
